{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
	"UUID": "com.lawrensen.hwinfo",
	"Name": "HWiNFO Sensors",
	"Version": "1.4.92.0",
	"Author": "Stephen Lawrensen",
	"Description": "Live HWiNFO sensor readings on your Stream Deck: temperatures, clocks, fan speeds, voltages, power and usage, rendered with seven display themes, sensor-type accents, warn/critical alert colors, sparklines, bar and ring gauges with threshold zones, and stat modes, plus dial and touchscreen support on the Stream Deck + and Stream Deck + XL. A key can stack two readings, list three as compact rows, or show four in a quad grid with per-cell colors, and a dial's touchscreen can list the rotation set as an overview: three compact rows, or two rows with big values and trend sparklines. A Text setting picks the text color per key, per dial or deck-wide, and data units render decimal (MB, Mbps) or binary (MiB, MiB/s). Requires HWiNFO with Shared Memory Support or Gadget reporting enabled; auto mode picks the best available source and recovers on its own when HWiNFO restarts.",
	"Category": "HWiNFO Sensors",
	"CategoryIcon": "imgs/plugin/category-icon",
	"CodePath": "bin/plugin.js",
	"Icon": "imgs/plugin/marketplace",
	"URL": "https://docs.slawrensen.com/hwinfo-streamdeck/",
	"SDKVersion": 3,
	"Software": {
		"MinimumVersion": "6.9"
	},
	"OS": [
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		}
	],
	"Nodejs": {
		"Version": "20"
	},
	"Actions": [
		{
			"Name": "Sensor Reading",
			"UUID": "com.lawrensen.hwinfo.reading",
			"Icon": "imgs/actions/reading/icon",
			"Tooltip": "Display up to four live HWiNFO sensor readings on a key: single, stacked, three rows or a quad grid, with alert thresholds on every layout and a sparkline, bar or ring on the single layout.",
			"PropertyInspectorPath": "ui/sensor-reading.html",
			"Controllers": [
				"Keypad"
			],
			"UserTitleEnabled": false,
			"States": [
				{
					"Image": "imgs/actions/reading/key",
					"TitleAlignment": "middle"
				}
			]
		},
		{
			"Name": "HWiNFO Control",
			"UUID": "com.lawrensen.hwinfo.control",
			"Icon": "imgs/actions/control/icon",
			"Tooltip": "Control Sensor Dials from any key, pedal or Multi Action: switch readings, pause the auto cycle, pin, reset session stats.",
			"PropertyInspectorPath": "ui/control.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/control/key",
					"TitleAlignment": "bottom"
				}
			]
		},
		{
			"Name": "Sensor Detail Slot",
			"UUID": "com.lawrensen.hwinfo.detail-slot",
			"Icon": "imgs/actions/reading/icon",
			"Tooltip": "Internal tile of the plugin-managed sensor detail view. Not placeable by hand: it appears only inside the bundled detail profiles.",
			"PropertyInspectorPath": "ui/detail-slot.html",
			"VisibleInActionsList": false,
			"UserTitleEnabled": false,
			"SupportedInMultiActions": false,
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/reading/key",
					"TitleAlignment": "middle"
				}
			]
		},
		{
			"Name": "Sensor Dial",
			"UUID": "com.lawrensen.hwinfo.dial",
			"Icon": "imgs/actions/dial/icon",
			"Tooltip": "Show a HWiNFO sensor on the touchscreen, as one readout or a three-row overview. Rotate to switch readings, press to reset session min/max.",
			"PropertyInspectorPath": "ui/sensor-dial.html",
			"Controllers": [
				"Encoder"
			],
			"UserTitleEnabled": false,
			"Encoder": {
				"layout": "layouts/sensor-dial.json",
				"Icon": "imgs/actions/dial/dial",
				"TriggerDescription": {
					"Rotate": "Cycle readings (set or sensor)",
					"Push": "Reset session min/max",
					"Touch": "Cycle stat mode",
					"LongTouch": "Back to current value"
				}
			},
			"States": [
				{
					"Image": "imgs/actions/dial/dial"
				}
			]
		}
	],
